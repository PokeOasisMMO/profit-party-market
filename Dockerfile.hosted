FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs npm \
    && rm -rf /var/lib/apt/lists/*

COPY gateway/requirements.txt gateway/requirements-databento.txt ./gateway/
RUN pip install --no-cache-dir -r gateway/requirements.txt -r gateway/requirements-databento.txt
RUN npm install --omit=dev --prefix gateway @microsoft/signalr@10.0.11

COPY gateway ./gateway

CMD ["python", "-m", "gateway.main"]
